<h2 class="text-center title">建立或編輯單招學生資料</h2>

<hr>

<div class="row" id="form-studentData">
	<div class="col-12">

        <div class="card">
            <div class="card-header bg-primary text-white">注意事項</div>
            <div class="card-body">
                <p>
                    <strong class="text-danger">建立單招通報說明</strong>
                    <ol>
                        <li>
                            請先選擇學制。
                        </li>
                        <li>
                            接著選擇要進行的動作。
                        </li>
                        <li>
                            然後選擇學系類型。
                        </li>
                        <li>
                            之後選擇學系類組。
                        </li>
                        <li>
                            最後填寫核定系名。
                        </li>
                    </ol>
                </p>
                <p>
                    <strong class="text-danger">請求填寫說明</strong>
                    <ol>
                        <li>
                            請記得點擊請求，填寫詳細資訊並上傳核定公文。
                        </li>
                        <li>
                            填寫完畢並確認無誤後，請按下發送請求按鈕。
                        </li>
                    </ol>
                </p>
            </div>
        </div>

        <table class="table table-hover sortable" style="border-collapse: collapse;">
            <thead>
                <tr>
                    <th></th><th></th><th></th><th></th><th></th><th></th><th></th><th></th>
                </tr>
                <tr>
                    <th>#</th>
                    <th>學年度</th>
                    <th>階段別</th>
                    <th>入學時間</th>
                    <th>通報次數</th>
                    <th>主旨</th>
                    <th>狀態</th>
                    <th></th>
                </tr>
            </thead>

            <tbody id="report-list">
            </tbody>

            <tfoot>
                <tr>
                    <th></th><th></th><th></th><th></th><th></th><th></th><th></th><th></th>
                </tr>
            </tfoot>

            <div class="row">
                <div class="col-12">
                    <table class="table table-hover">
                        <div id="pagination-container">
                        </div>
                    </table>
                </div>
            </div>
        </table>

        <div class="modal fade" id="student-data-modal" tabindex="-1" role="dialog" aria-labelledby="student-data-title">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content" id="modal-student-data">
                    <div class="modal-header">
                        <h5 id="student-data-modal-header"></h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="">
                            <ul class="nav nav-tabs" id="my-tab" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active" id="tab1-tab" data-toggle="tab" data-target="#tab1" type="button" role="tab" aria-controls="tab1" aria-selected="true">
                                        建立單一學生資料
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="tab2-tab" data-toggle="tab" data-target="#tab2" type="button" role="tab" aria-controls="tab2" aria-selected="false">
                                        上傳全部學生資料
                                    </button>
                                </li>
                            </ul>
                        </div>
                        <div class="tab-content" id="my-tab-content">
                            <div class="tab-pane fade show active" id="tab1" role="tabpanel" aria-labelledby="tab1-tab">
                                <form>
                                    <div class="card my-3" id="student-area">
                                        <div class="card-header bg-primary text-white">
                                            學生資料
                                        </div>
                                        <div class="card-body">
                                            <div class="row my-3">
                                                <div class="col-6">
                                                    <label>系統編號</label>
                                                    <input type="text" class="form-control" maxlength="191" id="user-id" disabled>
                                                </div>
                                                <div class="col-6">
                                                    <label>學生編號</label>
                                                    <input type="text" class="form-control" maxlength="191" id="student-id">
                                                </div>
                                            </div>
                                            <div class="row my-3">
                                                <div class="col-6">
                                                    <label>申請學制</label>
                                                    <select class="form-control selectpicker" id="system-id" data-style="btn-white" title="請選擇">
                                                        <!-- <option value="-1" selected disabled hidden>請選擇</option> -->
                                                        <option value="1">學士班</option>
                                                        <option value="2">港二技</option>
                                                        <option value="3">碩士班</option>
                                                        <option value="4">博士班</option>
                                                        <option value="4">轉學生</option>
                                                    </select>
                                                </div>
                                                <div class="col-6">
                                                    <label>身分別</label>
                                                    <select class="form-control selectpicker" id="identity" data-style="btn-white" title="請選擇">
                                                        <!-- <option value="-1" selected disabled hidden>請選擇</option> -->
                                                        <option value="1">港澳生</option>
                                                        <option value="2">港澳具外國國籍之華裔學生</option>
                                                        <option value="3">海外僑生</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="row my-3">
                                                <div class="col-6">
                                                    <label>姓名</label>
                                                    <input type="text" class="form-control" maxlength="191" id="name">
                                                </div>
                                                <div class="col-6">
                                                    <label>英文姓名</label>
                                                    <input type="text" class="form-control" maxlength="191" id="eng-name">
                                                </div>
                                            </div>
                                            <div class="row my-3">
                                                <div class="col-3">
                                                    <label>性別</label>
                                                    <select class="form-control selectpicker" id="gender" data-style="btn-white" title="請選擇">
                                                        <!-- <option value="-1" selected disabled hidden>請選擇</option> -->
                                                        <option value="M">男</option>
                                                        <option value="F">女</option>
                                                    </select>
                                                </div>
                                                <div class="col-9">
                                                    <label>E-mail</label>
                                                    <input type="text" class="form-control" maxlength="191" id="email">
                                                </div>
                                            </div>
                                            <div class="row my-3">
                                                <div class="col-6">
                                                    <label for="birthday">出生日期</label>
                                                    <input class="form-control input-datepicker" data-provide="datepicker" data-date-format="yyyy/mm/dd" id="birthday">
                                                </div>
                                                <div class="col-6">
                                                    <label>出生地</label>
                                                    <select class="form-control" id="birth-location" data-live-search="true" data-style="btn-white">
                                                        <!-- <option value="-1" selected disabled hidden>請選擇</option> -->
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card my-3" id="overseas-chinese-resident-area">
                                        <div class="card-header bg-primary text-white">
                                            僑居地資料
                                        </div>
                                        <div class="card-body">
                                            <div class="row my-3">
                                                <div class="col-6">
                                                    <label>僑居地</label>
                                                    <select class="form-control" id="resident-location" data-live-search="true" data-style="btn-white">
                                                        <!-- <option value="-1" selected disabled hidden>請選擇</option> -->
                                                    </select>
                                                </div>
                                                <div class="col-6">
                                                    <label>聯絡電話</label>
                                                    <input type="text" class="form-control" maxlength="191" id="resident-phone">
                                                </div>
                                            </div>
                                            <div class="row my-3">
                                                <div class="col-12">
                                                    <label">僑居地地址</label>
                                                    <input type="text" class="form-control" maxlength="191" id="resident-address">
                                                </div>
                                            </div>
                                            <div class="row my-3">
                                                <div class="col-6">
                                                    <label>移居僑居地年份</label>
                                                    <input type="text" class="form-control" maxlength="191" id="move-resident-location-year">
                                                </div>
                                                <div class="col-6">
                                                    <label>移居僑居地前居住地</label>
                                                    <select class="form-control" id="move-before-resident-location" data-live-search="true" data-style="btn-white">
                                                        <!-- <option value="-1" selected disabled hidden>請選擇</option> -->
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="row my-3">
                                                <div class="col-6">
                                                    <label>僑居地身分證號碼</label>
                                                    <input type="text" class="form-control" maxlength="191" id="resident-id">
                                                </div>
                                                <div class="col-6">
                                                    <label>僑居地護照號碼</label>
                                                    <input type="text" class="form-control" maxlength="191" id="resident-passport-no">
                                                </div>
                                            </div>
                                            <div class="row my-3">
                                                <div class="col-6">
                                                    <label>籍貫(省)</label>
                                                    <input type="text" class="form-control" maxlength="191" id="place-origin-province">
                                                </div>
                                                <div class="col-6">
                                                    <label>籍貫(縣市)</label>
                                                    <input type="text" class="form-control" maxlength="191" id="place-origin-county-city">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card my-3" id="taiwan-data-area">
                                        <div class="card-header bg-primary text-white d-flex align-items-center">
                                            在臺資料<span class="badge badge-warning ml-auto">無者免填</span>
                                        </div>
                                        <div class="card-body">
                                            <div class="row my-3">
                                                <div class="col-4">
                                                    <label>臺灣身分證號碼</label>
                                                    <input type="text" class="form-control" maxlength="191" id="taiwan-dd">
                                                </div>
                                                <div class="col-4">
                                                    <label>臺灣護照號碼</label>
                                                    <input type="text" class="form-control" maxlength="191" id="taiwan-passport-no">
                                                </div>
                                                <div class="col-4">
                                                    <label>臺灣電話</label>
                                                    <input type="text" class="form-control" maxlength="191" id="taiwan-phone">
                                                </div>
                                            </div>
                                            <div class="row my-3">
                                                <div class="col-12">
                                                    <label">臺灣地址</label>
                                                    <input type="text" class="form-control" maxlength="191" id="taiwan-address">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card my-3" id="parent-area">
                                        <div class="card-header bg-primary text-white">
                                            家長資料
                                        </div>
                                        <div class="card-body">
                                            <div class="row my-3">
                                                <div class="col-4">
                                                    <label for="">(父/母)姓名</label>
                                                    <input type="text" class="form-control" maxlength="191" id="dad-mom-name">
                                                </div>
                                                <div class="col-4">
                                                    <label for="">(父/母)英文姓名</label>
                                                    <input type="text" class="form-control" maxlength="191" id="dad-mom-eng-name">
                                                </div>
                                                <div class="col-4">
                                                    <label for="dad-mom-birthday">(父/母)出生日期</label>
                                                    <input class="form-control input-datepicker" data-provide="datepicker" data-date-format="yyyy/mm/dd" id="dad-mom-birthday">
                                                </div>
                                            </div>
                                            <div class="row my-3">
                                                <div class="col-4">
                                                    <label for="">(母/父)姓名</label>
                                                    <input type="text" class="form-control" maxlength="191" id="mom-dad-name">
                                                </div>
                                                <div class="col-4">
                                                    <label for="">(母/父)英文姓名</label>
                                                    <input type="text" class="form-control" maxlength="191" id="mom-dad-eng-name">
                                                </div>
                                                <div class="col-4">
                                                    <label for="mom-dad-birthday">(母/父)出生日期</label>
                                                    <input class="form-control input-datepicker" data-provide="datepicker" data-date-format="yyyy/mm/dd" id="mom-dad-birthday">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card my-3" id="tw-contact-area">
                                        <div class="card-header bg-primary text-white d-flex align-items-center">
                                            在臺聯絡人資料<span class="badge badge-warning ml-auto">無者免填</span>
                                        </div>
                                        <div class="card-body">
                                            <div class="row my-3">
                                                <div class="col-6">
                                                    <label for="">聯絡人姓名</label>
                                                    <input type="text" class="form-control" maxlength="191" id="tw-contact-name">
                                                </div>
                                                <div class="col-6">
                                                    <label for="">聯絡人電話</label>
                                                    <input type="text" class="form-control" maxlength="191" id="tw-contact-phone">
                                                </div>
                                            </div>
                                            <div class="row my-3">
                                                <div class="col-12">
                                                    <label for="">在臺聯絡人地址</label>
                                                    <input type="text" class="form-control" maxlength="191" id="tw-contact-address">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card my-3" id="education-area">
                                        <div class="card-header bg-primary text-white">
                                            學歷資料
                                        </div>
                                        <div class="card-body">
                                            <div class="row my-3">
                                                <div class="col-6">
                                                    <label>最高學歷取得地</label>
                                                    <select class="form-control" id="school-location" data-live-search="true" data-style="btn-white">
                                                        <!-- <option value="-1" selected disabled hidden>請選擇</option> -->
                                                    </select>
                                                </div>
                                                <div class="col-6">
                                                    <label for="">學校名稱</label>
                                                    <input type="text" class="form-control" maxlength="191" id="school-name">
                                                </div>
                                            </div>
                                            <div class="row my-3">
                                                <div class="col-12">
                                                    <label for="">學歷</label>
                                                    <input type="text" class="form-control" maxlength="191" id="education-system-description">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 my-3">
                                            <div class="card" id="apply-item">
                                                <div class="card-header bg-primary text-white">
                                                    申請醫、牙及中醫學系
                                                </div>
                                                <div class="card-body">
                                                    <div class="row">
                                                        <div class="form-check form-check-inline mx-3">
                                                            <label class="form-check-label">
                                                                <input class="form-check-input apply-medicine-dentist" type="radio" name="apply-medicine-dentist" value="1"> 是
                                                            </label>
                                                        </div>
                                                        <div class="form-check form-check-inline mx-3">
                                                            <label class="form-check-label">
                                                                <input class="form-check-input apply-medicine-dentist" type="radio" name="apply-medicine-dentist" value="0"> 否
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6 my-3">
                                            <div class="card" id="apply-category">
                                                <div class="card-header bg-primary text-white">
                                                    申請類別
                                                </div>
                                                <div class="card-body">
                                                    <div class="row">
                                                        <div class="form-check form-check-inline mx-3">
                                                            <label class="form-check-label">
                                                                <input class="form-check-input apply-way" type="radio" name="apply-way" value="1"> 單獨招生
                                                            </label>
                                                        </div>
                                                        <div class="form-check form-check-inline mx-3">
                                                            <label class="form-check-label">
                                                                <input class="form-check-input apply-way" type="radio" name="apply-way" value="2"> 專班
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card my-3" id="others-area">
                                        <div class="card-header bg-primary text-white d-flex align-items-center">
                                            其他<span class="badge badge-warning ml-auto">選填</span>
                                        </div>
                                        <div class="card-body">
                                            <div class="row my-3">
                                                <div class="col-12">
                                                    <label for="">備註</label>
                                                    <textarea type="text" class="form-control" maxlength="191" id="student-memo"></textarea>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card hide my-3" id="upload-student-data-file-area">
                                        <div class="card-header bg-primary text-white">
                                            上傳學生檔案
                                        </div>
                                        <div class="card-body">
                                            <div class="alert alert-warning">
                                                可接受副檔名為 <strong class="text-danger">pdf、jpg、png</strong> 的檔案，單一個檔案大小需 <strong class="text-danger">小於 8 Mbytes</strong> 。
                                            </div>

                                            <div class="row btn-upload" style="margin-bottom: 15px;">
                                                <div class="col-12">
                                                    <input type="file" class="filestyle student-data-file-upload" id="student-data-file-upload"
                                                    data-btnClass="btn-success"
                                                    data-input="false"
                                                    data-text=" 選取檔案"
                                                    data-Icon="<i class='fa fa-folder-open' aria-hidden='true'/>"
                                                    multiple>
                                                </div>
                                            </div>

                                            <div class="card">
                                                <div class="card-body">
                                                    <h4 class="card-title"><span>已上傳檔案</span> <small class="text-muted">(點圖可放大或刪除)</small></h4>
                                                    <div id="uploaded-student-data-file-area">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- <div class="row">
                                        <div class="form-group col-12">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <div class="input-group-text">
                                                        備註
                                                    </div>
                                                </div>
                                                <textarea type="text" class="form-control" maxlength="191" id="memo"></textarea>
                                            </div>
                                        </div>
                                    </div> -->
                                </form>

                            </div>
                            <div class="tab-pane fade" id="tab2" role="tabpanel" aria-labelledby="tab2-tab">
                                <p>這是 Tab 2 的內容。</p>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-primary" id="save-student-data-btn"><i class="fa fa-save" aria-hidden="true"></i> 儲存</button>
                        <button type="button" class="btn btn-secondary" data-dismiss="modal"><i class="fa fa-sign-out" aria-hidden="true"></i> 離開</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="student-data-list-modal" tabindex="-1" role="dialog" aria-labelledby="student-data-list-title">
            <div class="modal-dialog modal-xxl" role="document">
                <div class="modal-content" id="modal-student-data-list">
                    <div class="modal-header">
                        <h5 id="student-data-list-modal-header"></h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="col-md-5 col-6 text-right">
                            <div class="form-group">
                                <input id="student-filter" class="form-control" type="text" placeholder="搜尋 報名序號、僑編、姓名、EMAIL">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <table id="student-list" class="table table-hover sortable">
                                    <thead>
                                    <tr>
                                        <th data-defaultsign='nospan'></th>
                                        <th>報名序號</th>

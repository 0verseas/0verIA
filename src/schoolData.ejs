<div id="form-schoolData">
	<div class="row">
		<div class="form-group col-6">
			<label for="">學校中文名稱</label>
			<input id="title" type="text" class="form-control" disabled>
		</div>
		<div class="form-group col-6">
			<label for="">學校英文名稱</label>
			<input id="engTitle" type="text" class="form-control" disabled>
		</div>
	</div>

	<div class="card" id="uploadApprovalDocOfSelfEnrollmentArea">
		<div class="card-header bg-primary text-white">
			上傳單招核定公文電子檔
		</div>
		<div class="card-body">
			<div class="row">
				<div id="approvalNoOfSelfEnrollmentForm" class="form-group col-12">
					<label class="form-control-label text-danger" for="">教育部核定單招公文發文日期及文號 *</label>
					<input maxlength="191" id="approvalNoOfSelfEnrollment" type="text" class="form-control">
				</div>
			</div>
			<!-- <div class="alert alert-warning">
				可接受副檔名為 <strong class="text-danger">pdf、jpg、png</strong> 的檔案，單一個檔案大小需 <strong class="text-danger">小於 4 Mbytes</strong> 。
			</div> -->

			<div class="row btn-upload" style="margin-bottom: 15px;">
				<div class="col-12">
					<input type="file" class="filestyle approval-doc-of-self-enrollment-upload"
						id="approval-doc-of-self-enrollment-upload"
						data-id="approval-doc-of-self-enrollment-file"
						data-btnClass="btn-success"
						data-input="false"
						data-text=" 選取檔案"
						data-Icon="<i class='fa fa-folder-open' aria-hidden='true'/>"
						multiple>
				</div>
			</div>

			<div class="card">
				<div class="card-body">
					<h4 class="card-title"><span>已上傳檔案</span> <small class="text-muted">(點圖可放大或刪除)</small></h4>
					<div id="uploadedApprovalDocOfSelfEnrollmentArea">
					</div>
				</div>
			</div>
		</div>
    </div>
	<div class="card" id="uploadApprovalDocOfTestSelfEnrollmentArea">
		<div class="card-header bg-primary text-white">
			上傳試辦來臺入（轉）學專案單獨招生核定公文電子檔
		</div>
		<div class="card-body">
			<!-- 新增勾選框區塊 -->
			<div class="row mb-3">
				<div class="col-12">
					<div class="custom-control custom-checkbox">
						<input type="checkbox" class="custom-control-input" id="hasTestSelfEnrollment">
						<label class="custom-control-label" for="hasTestSelfEnrollment">
							貴校是否經教育部核定可辦理此專案單招（如有請勾選，無則免勾）
						</label>
					</div>
				</div>
			</div>

			<!-- 使用容器包裹需要連動顯示/隱藏的內容，預設隱藏 (style="display:none") -->
			<div id="testSelfEnrollmentContent" style="display:none;">
				<div class="row">
					<div id="approvalNoOfTestSelfEnrollmentForm" class="form-group col-12">
						<label class="form-control-label" for="">試辦來臺入（轉）學專案單獨招生核定文號</label>
						<input maxlength="191" id="approvalNoOfTestSelfEnrollment" type="text" class="form-control">
					</div>
				</div>

				<div class="row btn-upload" style="margin-bottom: 15px;">
					<div class="col-12">
						<input type="file" class="filestyle approval-doc-of-test-self-enrollment-upload"
							id="approval-doc-of-test-self-enrollment-upload"
							data-id="approval-doc-of-test-self-enrollment-file"
							data-btnClass="btn-success"
							data-input="false"
							data-text=" 選取檔案"
							data-Icon="<i class='fa fa-folder-open' aria-hidden='true'/>"
							multiple>
					</div>
				</div>

				<div class="card">
					<div class="card-body">
						<h4 class="card-title"><span>已上傳檔案</span> <small class="text-muted">(點圖可放大或刪除)</small></h4>
						<div id="uploadedApprovalDocOfTestSelfEnrollmentArea"></div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="modal fade img-modal" tabindex="-1" role="dialog" aria-labelledby="imgModal" aria-hidden="true" id="img-modal">
		<div class="modal-dialog modal-lg">
			<div class="modal-content">
				<div class="modal-body text-center" id="img-modal-body">
					<img src="" class="img-fluid rounded img-ori">
				</div>
				<div class="modal-footer">
	                <!-- <button type="button" class="btn btn-danger delete-action"><i class="fa fa-trash" aria-hidden="true"></i> 刪除</button> -->
					<button type="button" class="btn btn-danger" id="delete-school-data-file-btn"><i class="fa fa-trash" aria-hidden="true"></i> 刪除</button>
	                <!-- <button type="button" class="btn btn-danger delete-student-data-file"><i class="fa fa-trash" aria-hidden="true"></i> 刪除</button> -->
					<button type="button" class="btn btn-secondary" data-dismiss="modal"><i class="fa fa-sign-out" aria-hidden="true"></i> 離開</button>
				</div>
			</div>
		</div>
	</div>
	<hr>
	<div class="row" style="place-content:center">
		<div class="text-center">
			<button id="btn-save" data-action="save" class="btn btn-primary">
				儲存
			</button>
		</div>
    </div>
</div>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-filestyle/1.3.0/bootstrap-filestyle.min.js"> </script>
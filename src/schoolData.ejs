	<div class="card" id="uploadApprovalDocOfSelfEnrollmentArea">
		<div class="card-header bg-primary text-white">
			上傳單招核定公文電子檔
		</div>
		<div class="card-body">
			<div class="row">
				<div id="approvalNoOfSelfEnrollmentForm" class="form-group col-12">
					<label class="form-control-label text-danger" for="">教育部核定單招公文發文日期及文號 *</label>
					<input maxlength="191" id="approvalNoOfSelfEnrollment" type="text" class="form-control">
				</div>
			</div>
			<!-- <div class="alert alert-warning">
				可接受副檔名為 <strong class="text-danger">pdf、jpg、png</strong> 的檔案，單一個檔案大小需 <strong class="text-danger">小於 4 Mbytes</strong> 。
			</div> -->

			<div class="row btn-upload" style="margin-bottom: 15px;">
				<div class="col-12">
					<input type="file" class="filestyle approval-doc-of-self-enrollment-upload" id="approval-doc-of-self-enrollment-upload"
					data-btnClass="btn-success"
					data-input="false"
					data-text=" 選取檔案"
					data-Icon="<i class='fa fa-folder-open' aria-hidden='true'/>"
					multiple>
				</div>
			</div>

			<div class="card">
				<div class="card-body">
					<h4 class="card-title"><span>已上傳檔案</span> <small class="text-muted">(點圖可放大或刪除)</small></h4>
					<div id="uploadedApprovalDocOfSelfEnrollmentArea">
					</div>
				</div>
			</div>
		</div>
    </div>
	<div class="card" id="uploadApprovalDocOfTestSelfEnrollmentArea">
		<div class="card-header bg-primary text-white">
			上傳試辦來臺入（轉）學專案單獨招生核定公文電子檔
		</div>
		<div class="card-body">
			<div class="row">
				<div id="approvalNoOfTestSelfEnrollmentForm" class="form-group col-12">
					<label class="form-control-label" for="">試辦來臺入（轉）學專案單獨招生核定文號</label>
					<input maxlength="191" id="approvalNoOfTestSelfEnrollment" type="text" class="form-control">
				</div>
			</div>
			<!-- <div class="alert alert-warning">
				可接受副檔名為 <strong class="text-danger">pdf、jpg、png</strong> 的檔案，單一個檔案大小需 <strong class="text-danger">小於 4 Mbytes</strong> 。
